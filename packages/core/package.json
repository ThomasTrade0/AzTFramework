{
  "name": "@azt/core",
  "version": "0.1.0",
  "description": "Foundational primitives for AzTFramework: Result type, error model, a lightweight DI container and disposable lifecycles.",
  "type": "module",
  "license": "MIT",
  "author": "Thomas Azarian <azarian.records.azarood@gmail.com>",
  "homepage": "https://github.com/ThomasTrade0/AzTFramework/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasTrade0/AzTFramework.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ThomasTrade0/AzTFramework/issues"
  },
  "keywords": [
    "typescript",
    "result-type",
    "error-handling",
    "dependency-injection",
    "toolkit"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
