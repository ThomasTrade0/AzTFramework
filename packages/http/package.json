{
  "name": "@azt/http",
  "version": "0.1.0",
  "description": "A typed fetch-based HTTP client with retries/timeouts, and a minimal Node HTTP router for building small APIs.",
  "type": "module",
  "license": "MIT",
  "author": "Thomas Azarian <azarian.records.azarood@gmail.com>",
  "homepage": "https://github.com/ThomasTrade0/AzTFramework/tree/main/packages/http#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ThomasTrade0/AzTFramework.git",
    "directory": "packages/http"
  },
  "bugs": {
    "url": "https://github.com/ThomasTrade0/AzTFramework/issues"
  },
  "keywords": [
    "typescript",
    "http-client",
    "http-server",
    "router",
    "fetch",
    "retry"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azt/core": "^0.1.0"
  }
}
